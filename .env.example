# Longbridge / LongPort OpenAPI credentials.
# Get these from https://open.longportapp.com/ -> Developer console.
# NOTE: longport 3.0.x reads these via Config.from_env().
LONGPORT_APP_KEY=
LONGPORT_APP_SECRET=
LONGPORT_ACCESS_TOKEN=

# Optional. "en", "zh-CN", or "zh-HK".
LONGPORT_LANGUAGE=en

# Optional. Set true to include US pre/post-market (free with US LV1).
LONGPORT_ENABLE_OVERNIGHT=false
